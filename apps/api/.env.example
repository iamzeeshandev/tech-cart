# Copy to .env and fill in. Never commit .env (it will hold Stripe secrets later).

PORT=4000

# Local Postgres from docker-compose.yml (host port 5435). Use 127.0.0.1, not localhost:
# on Windows localhost resolves to IPv6 ::1 first, and the container only listens on IPv4.
DATABASE_URL="postgresql://techcart:techcart@127.0.0.1:5435/techcart?schema=public"

# Stripe sandbox secret key: Dashboard (sandbox selected) → Developers → API keys.
# Server only. Never put it in apps/web, git, chat or logs.
STRIPE_SECRET_KEY=sk_test_replace_me

# The Next.js app; Stripe Checkout redirects back here after payment or cancel.
WEB_URL=http://localhost:3000
